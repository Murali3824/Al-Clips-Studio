{
  "pipelineVersion": "2.4.0",
  "schemaVersion": "1.1",
  "whisper": {
    "defaultModel": "medium",
    "computeType": "int8",
    "beamSize": 5,
    "language": null
  },
  "crop": {
    "smoothingAlpha": 0.35,
    "targetRatio": "9:16",
    "shortsWidth": 1080,
    "shortsHeight": 1920,
    "primaryPersonAreaRatio": 0.03,
    "multiPersonRatioThreshold": 0.25,
    "faceConfidenceThreshold": 0.40
  },
  "render": {
    "preset": "veryfast",
    "crf": 23,
    "audioCodec": "aac",
    "videoCodec": "libx264",
    "blurStrength": 25,
    "musicVolumeDefault": 20
  },
  "branding": {
    "channelName": "ClipForge World",
    "brandHashtags": ["#clipforgeworld", "#clipforge"],
    "maxHashtags": 16
  },
  "ollama": {
    "baseUrl": "http://localhost:11434",
    "model": "llama3:8b",
    "temperature": 0.7,
    "timeoutSeconds": 5.0
  }
}
